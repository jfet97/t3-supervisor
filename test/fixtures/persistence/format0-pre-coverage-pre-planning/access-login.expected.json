      "sql": "CREATE TABLE dashboard_login_grants (\n        token_hash TEXT PRIMARY KEY NOT NULL CHECK(length(token_hash)=64),\n        issued_at INTEGER NOT NULL,\n        expires_at INTEGER NOT NULL CHECK(expires_at > issued_at)\n      ) STRICT"
    },
    {
      "type": "table",
      "name": "dashboard_login_sessions",
      "tbl_name": "dashboard_login_sessions",
      "sql": "CREATE TABLE dashboard_login_sessions (\n        token_hash TEXT PRIMARY KEY NOT NULL CHECK(length(token_hash)=64),\n        issued_at INTEGER NOT NULL,\n        expires_at INTEGER NOT NULL CHECK(expires_at > issued_at AND expires_at - issued_at <= 2592000000)\n      ) STRICT"
    }
