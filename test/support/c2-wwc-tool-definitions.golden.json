{
  "workflowReadToolDefinition": {
    "name": "workflow_read",
    "description": "Read compact workflow status and fresh paged native lineage by default, or request context, definitions, instructions, interpretation, check, the frozen envelope of one of your own check-ins (view request) or complete documents. Writes accept only strong native item references; a record or currentAgreementKey proves neither acceptance, execution nor definition validity, and main-reported external contributions stay untrusted until assessed.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supervisorThreadId",
        "bindingGeneration"
      ],
      "properties": {
        "memberEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "assignmentRootThreadId": {
          "type": "string",
          "minLength": 1
        },
        "assignmentEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "supervisorThreadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bindingGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "workflowId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "workflowOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "lineageOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "view": {
          "type": "string",
          "enum": [
            "status",
            "documents",
            "context",
            "definitions",
            "instructions",
            "interpretation",
            "check",
            "request"
          ],
          "description": "Omit for status: current occurrences, nesting, progress, branch reach, omissions, attempts and fresh paged lineage. lineageOffset pages native descendants without complete documents. documents explicitly requests complete paged records with history, evidence and accepted snapshots. context: task identities, states and requested sections. definitions: index or complete definitionIds. instructions: core/index or a requested section. interpretation: classification or requested plan rules. check: dry-run one proposal without publishing it."
        },
        "section": {
          "type": "string",
          "description": "With view instructions: one section id from its index. With view interpretation: \"plan\", read only when a plan is needed. With view context: \"conversation\", \"plan\" or \"diagnostics\"."
        },
        "revision": {
          "type": "string",
          "enum": [
            "approved",
            "observed"
          ],
          "description": "With view definitions: the approved definitions of the task (default) or the checkout's current ones."
        },
        "definitionIds": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "With view definitions: exact step or workflow IDs to return completely."
        },
        "includeSources": {
          "type": "boolean",
          "description": "With view definitions: also return raw definition source files, for diagnosing invalid or incomplete definitions."
        },
        "record": {
          "type": "object",
          "description": "With view check: the exact compact workflow-proposal record to validate."
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "With view request: the requestId a check-in or liveness wake of your own names; returns its frozen envelope (rows, counts, handles, routes, pins and indexes), during the turn and after its acknowledgement."
        }
      }
    }
  },
  "workflowWriteToolDefinition": {
    "name": "workflow_write",
    "description": "Create the main draft, link a verified live descendant, apply semantic workflow changes with revision CAS, assess a main-reported external contribution result (it never changes any status), or record a check-in's outcome (record_review is root-only; It sends nothing; messaging the operative is a separate decision), as sections workflow_edit and monitoring of workflow_read view instructions describe. The service verifies your own executed call; keep operationId unique within this binding. New live steps start \"planned\"; mark them underway or completed in a separate later apply with status_changed evidence. Optional sourceThreadId/sourceRunId/sourceMessageId/sourceItemId link existing in-scope T3 activity for navigation, never proof or authority. On rejection, read the reason, code, and path.",
    "inputSchema": {
      "$defs": {
        "group": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "nodes"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "sequence",
                "parallel"
              ]
            },
            "templatePath": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        "node": {
          "oneOf": [
            {
              "$ref": "#/$defs/group"
            },
            {
              "$ref": "#/$defs/step"
            },
            {
              "$ref": "#/$defs/workflow"
            },
            {
              "$ref": "#/$defs/branch"
            },
            {
              "$ref": "#/$defs/back_to"
            }
          ]
        },
        "back_to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "maximum",
            "reason"
          ],
          "description": "A return to the earlier step or workflow member of the same sequential lane whose definitionId or localId is target. maximum is the most successful jumps of this return, an integer from 1 to 99; the first pass consumes none. It ends its path. Keep nodeId, templatePath and budgetId of an existing return; the service resolves targetNodeId.",
          "properties": {
            "kind": {
              "const": "back_to"
            },
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "templatePath": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "targetNodeId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            "budgetId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "branch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "condition",
            "reason",
            "then"
          ],
          "description": "A coarse semantic branch: the operative selects then or else from actual context with its own branch-selection record. Keep nodeId and templatePath of an existing branch; a definition branch keeps its condition and paths.",
          "properties": {
            "kind": {
              "const": "branch"
            },
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "templatePath": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "condition": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
