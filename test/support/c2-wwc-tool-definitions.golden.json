                      }
                    ]
                  },
                  "sourceThreadId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "description": "An exact opaque native T3 ID copied verbatim."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceRunId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "description": "An exact opaque native T3 ID copied verbatim."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceMessageId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "description": "An exact opaque native T3 ID copied verbatim."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceItemId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "description": "An exact opaque native T3 ID copied verbatim."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "workflowId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        },
        "contributionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "resultRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "decision": {
