{
  "workflowReadToolDefinition": {
    "name": "workflow_read",
    "description": "Read this Supervisor binding's workflow documents, or one view: status, context, definitions, instructions, interpretation or check. Writes accept only strong native item references; a record or currentAgreementKey proves neither acceptance, execution nor definition validity, and main-reported external contributions stay untrusted until assessed.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supervisorThreadId",
        "bindingGeneration"
      ],
      "properties": {
        "memberEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "assignmentRootThreadId": {
          "type": "string",
          "minLength": 1
        },
        "assignmentEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "supervisorThreadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bindingGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "workflowId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "workflowOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "lineageOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "view": {
          "type": "string",
          "enum": [
            "status",
            "context",
            "definitions",
            "instructions",
            "interpretation",
            "check"
          ],
          "description": "Omit for complete workflow documents. status: each current workflow's occurrences with nodeId, nesting, status, branch reach and visible omissions, without descriptions, accepted snapshots or history; use it to reconcile statuses. context: current task, objective, revisions, proposal, agreement and diagnostic. definitions: the project.yaml index, or the exact complete definitions for definitionIds. instructions: the full standing Supervisor instructions. interpretation: only the interpretation instructions. check: dry-run one compact workflow-proposal record without publishing it."
        },
        "section": {
          "type": "string",
          "description": "With view instructions: one section id from its index. With view interpretation: \"plan\", read only when a plan is needed. With view context: \"conversation\", \"plan\" or \"diagnostics\"."
        },
        "revision": {
          "type": "string",
          "enum": [
            "approved",
            "observed"
          ],
          "description": "With view definitions: the approved definitions of the task (default) or the checkout's current ones."
        },
        "definitionIds": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "With view definitions: exact step or workflow IDs to return completely."
        },
        "includeSources": {
          "type": "boolean",
          "description": "With view definitions: also return raw definition source files, for diagnosing invalid or incomplete definitions."
        },
        "record": {
          "type": "object",
          "description": "With view check: the exact compact workflow-proposal record to validate."
        }
      }
    }
  },
  "workflowWriteToolDefinition": {
    "name": "workflow_write",
    "description": "Create the main draft, link a verified live descendant, apply semantic workflow changes with revision CAS, assess a main-reported external contribution result (it never changes any status), or record a check-in's outcome (record_review is root-only; It sends nothing; messaging the operative is a separate decision), as sections workflow_edit and monitoring of workflow_read view instructions describe. The service verifies your own executed call; keep operationId unique within this binding. New live steps start \"planned\"; mark them underway or completed in a separate later apply with status_changed evidence. Optional sourceThreadId/sourceRunId/sourceMessageId/sourceItemId link existing in-scope T3 activity for navigation, never proof or authority. On rejection, read the reason, code, and path.",
    "inputSchema": {
      "$defs": {
        "group": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "nodes"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "sequence",
                "parallel"
              ]
            },
            "templatePath": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        "node": {
          "oneOf": [
            {
              "$ref": "#/$defs/group"
            },
            {
              "$ref": "#/$defs/step"
            },
            {
              "$ref": "#/$defs/workflow"
            },
            {
              "$ref": "#/$defs/branch"
            },
            {
              "$ref": "#/$defs/back_to"
            }
          ]
        },
        "back_to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "reason"
          ],
          "description": "A return to the earlier step or workflow member of the same sequential lane whose definitionId or localId is target; it ends its path. Keep nodeId and templatePath of an existing return; the service resolves targetNodeId.",
          "properties": {
            "kind": {
              "const": "back_to"
            },
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "templatePath": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "targetNodeId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "branch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "condition",
            "reason",
            "then"
          ],
          "description": "A coarse semantic branch: the operative selects then or else from actual context with its own branch-selection record. Keep nodeId and templatePath of an existing branch; a definition branch keeps its condition and paths.",
          "properties": {
            "kind": {
              "const": "branch"
            },
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "templatePath": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "condition": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "then": {
              "$ref": "#/$defs/group"
            },
            "else": {
              "anyOf": [
                {
                  "$ref": "#/$defs/group"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "path",
            "sourceId"
          ],
          "properties": {
            "origin": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "global",
                    "project"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "path": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceId": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "step": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "step"
            },
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "definitionId": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "localId": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "templatePath": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 8000
            },
            "references": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "skills": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "uniqueItems": true,
              "description": "Canonical checkout-relative SKILL.md paths or exact catalog names (up to 256 characters, optional colon namespaces)."
            },
            "source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/source"
                },
                {
                  "type": "null"
                }
              ]
            },
            "resolution": {
              "type": "string",
              "enum": [
                "resolved",
                "unresolved"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "status": {
              "type": "string",
              "enum": [
                "planned",
                "underway",
                "completed",
                "needs_attention"
              ]
            },
            "contributorThreadIds": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "definitionId",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "workflow"
            },
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "definitionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "templatePath": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "maxLength": 8000
            },
            "references": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "skills": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "uniqueItems": true,
              "description": "Canonical checkout-relative SKILL.md paths or exact catalog names (up to 256 characters, optional colon namespaces)."
            },
            "fixed": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/source"
                },
                {
                  "type": "null"
                }
              ]
            },
            "resolution": {
              "type": "string",
              "enum": [
                "resolved",
                "partial",
                "unresolved"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "status": {
              "type": "string",
              "enum": [
                "planned",
                "underway",
                "completed",
                "needs_attention"
              ]
            },
            "contributorThreadIds": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "omissions": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "templatePath",
                  "kind",
                  "id",
                  "name",
                  "source",
                  "reason"
                ],
                "properties": {
                  "templatePath": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "step",
                      "workflow"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "source": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/source"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              }
            },
            "plan": {
              "anyOf": [
                {
                  "$ref": "#/$defs/group"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "supervisorThreadId",
        "bindingGeneration"
      ],
      "properties": {
        "memberEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "assignmentRootThreadId": {
          "type": "string",
          "minLength": 1
        },
        "assignmentEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "supervisorThreadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bindingGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "action": {
          "type": "string",
          "enum": [
            "ensure_main",
            "link_child",
            "apply",
            "assess_contribution",
            "record_review"
          ]
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Unique within this Supervisor binding and the edit namespace; use a stable action suffix."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "childThreadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operationId",
            "workflowId",
            "expectedRevision",
            "note"
          ],
          "properties": {
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Unique within this Supervisor binding and the edit namespace; use a stable action suffix."
            },
            "workflowId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "planned",
                "underway",
                "completed",
                "needs_attention"
              ]
            },
            "objective": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "sourceBinding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workspaceRoot",
                "revision",
                "globalRevision",
                "definitionsStatus",
                "definitionsComplete",
                "requirementsKnown",
                "taskId",
                "proposalId",
                "sourceHash"
              ],
              "properties": {
                "workspaceRoot": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "revision": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 256
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "globalRevision": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 256
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "definitionsStatus": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "missing",
                    "invalid",
                    "permission_required",
                    "unavailable"
                  ]
                },
                "definitionsComplete": {
                  "type": "boolean"
                },
                "requirementsKnown": {
                  "type": "boolean"
                },
                "taskId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "proposalId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "sourceHash": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "requirements": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "name",
                  "source",
                  "state",
                  "reason"
                ],
                "properties": {
                  "kind": {
