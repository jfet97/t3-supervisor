          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "outcome": {
          "type": "string",
          "enum": [
            "progress_updated",
            "no_change",
            "needs_attention",
            "insufficient_evidence"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "applyOperationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "wait": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "waitingOn",
            "resumesWhen"
          ],
          "description": "With record_review: an explicit current wait when the main has stopped with agreed work unfinished: who must act (requester or external, never the operative's own unfinished action) and what resumes the work.",
          "properties": {
            "waitingOn": {
              "type": "string",
              "enum": [
                "requester",
                "external"
              ]
            },
            "resumesWhen": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "ensure_main"
            }
          },
          "required": [
            "operationId",
            "note"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "link_child"
            }
          },
          "required": [
            "operationId",
            "childThreadId",
            "note"
          ]
        },
        {
          "properties": {
