#!/bin/sh
# The host entry point of the Docker development environment (docs/local-stack.md). The host needs Docker with the
# Compose plugin and nothing else; every command runs inside the development containers.
set -eu

repo=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

usage() {
  cat <<'USAGE'
usage: ./dev [--env NAME] [--port-base N] COMMAND [ARGS]

  setup               build the image and install dependencies (T3's Setup Worktree action)
  up                  setup, build the dashboard, then start T3 and Supervisor and wait until healthy
  stop | start        stop or start the containers; nothing is removed
  down                remove the containers and their network; every volume stays
  restart             restart T3 and Supervisor in their container
  recreate            recreate the container from the current image; every volume stays
  rebuild             rebuild the image from its pinned base, then recreate; every volume stays
  status              containers, health and the provider CLIs' sign-in status
  logs [ARGS]         the T3 and Supervisor log (docker compose logs)
  shell               an interactive shell in the toolchain container
  pnpm ARGS           pnpm in the toolchain container, for example ./dev pnpm test test/config.characterization.test.ts
  login codex|claude [ARGS]   sign in to a provider CLI; the login stays in the credentials volume
  pair                a one-time link that opens this environment's T3 in the browser
  sign-in             a one-time Supervisor dashboard sign-in token
  fixture [ARGS]      the dashboard fixture: production Supervisor over scripted T3 states
  ui-fixture [ARGS]   the synthetic dashboard API fixture
  check [ARGS]        a disposable published-T3 stack check, removed when it ends
  upgrade --journey stable|nightly|baseline [--releases FILE] [--t3-lock FILE] [--out DIR] [--keep]
                      a provider-free published Supervisor upgrade journey: the published release runs from its official
                      image, pinned by digest in the release lock FILE (pnpm dev:releases), or this checkout creates the
                      directory (baseline); then this checkout upgrades it (scripts/upgrade-journey.ts)
  e2e [ARGS]          the browser journeys: builds the dashboard, then runs vitest with vitest.e2e.config.ts in the e2e
                      image (ARGS go to vitest); each journey owns its Supervisor, scripted T3 and Chromium
  soak [ARGS]         the scripted soaks: vitest with vitest.soak.config.ts in the toolchain container (ARGS go to vitest);
                      each soak runs the Supervisor process against a fake T3 on the wall clock, without credentials
  trial SCENARIO[,SCENARIO...] --budget-minutes N [--follow-up-minutes M] [--model MODEL] [--keep]
                      a provider trial in the running signed-in environment: a disposable project and chat of its own,
                      or a No Project chat of its own, observed for the whole budget, then removed unless --keep;
                      several observing workload scenarios may share one launch; local only, never in CI
                      (scripts/provider-trial.ts, docs/local-stack.md)
  reset               remove test data: the workspaces' T3 projects with their chats, Supervisor data and the
                      workspaces; provider sign-ins, T3 settings and T3 provider connections stay
  reset-auth          sign out every provider: T3's own sign-out for each instance it offers one for, including
                      T3-managed connections, then the Codex and Claude CLI logins; T3 chats and all data stay

NAME selects an independent environment with its own volumes (default: default, or T3SUP_DEV_ENV). Port N+73 serves T3,
N+8 the dashboard, N+7 health, N+1 the dashboard fixture and N+10 the UI fixture (default 47700, or T3SUP_DEV_PORT_BASE).
USAGE
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

install='pnpm install --frozen-lockfile --prefer-offline --store-dir /cache/pnpm-store'

# inside the development container, for example T3's Setup Worktree action, the container's own toolchain runs directly;
# managing containers stays a host command, so there is never a Docker client or socket in here
if [ "${T3SUP_DEV_CONTAINER:-}" = 1 ]; then
  case ${1:-} in
    setup) cd "$repo" && exec $install ;;
    pnpm) shift; cd "$repo" && exec pnpm "$@" ;;
    -h|--help|help) usage; exit 0 ;;
    *) die "./dev ${1:-} manages the development containers from the host; inside the container run pnpm directly" ;;
  esac
fi

name=${T3SUP_DEV_ENV:-default}
base=${T3SUP_DEV_PORT_BASE:-47700}
while [ $# -gt 0 ]; do
  case $1 in
    --env) [ $# -ge 2 ] || die "--env needs a name"; name=$2; shift 2 ;;
    --port-base) [ $# -ge 2 ] || die "--port-base needs a number"; base=$2; shift 2 ;;
    -h|--help|help) usage; exit 0 ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { usage >&2; exit 2; }
command=$1
shift

case $name in ''|-*|*[!a-z0-9-]*) die "environment names use the characters a-z, 0-9 and -" ;; esac
case $base in ''|*[!0-9]*) die "--port-base needs a number" ;; esac
{ [ "$base" -ge 1025 ] && [ "$base" -le 65400 ]; } || die "--port-base must be between 1025 and 65400"
command -v docker >/dev/null 2>&1 || die "Docker is required: https://docs.docker.com/get-started/get-docker/"
docker compose version >/dev/null 2>&1 || die "the Docker Compose plugin is required: https://docs.docker.com/compose/install/"

project="t3sup-dev-$name"
uid=$(id -u)
gid=$(id -g)
# the development user never runs as root, also when the host user is root
if [ "$uid" -eq 0 ]; then uid=1000; gid=1000; fi
export DEV_UID="$uid" DEV_GID="$gid"
export T3SUP_DEV_T3_PORT=$((base + 73)) T3SUP_DEV_UI_PORT=$((base + 8)) T3SUP_DEV_HEALTH_PORT=$((base + 7))
export T3SUP_DEV_FIXTURE_PORT=$((base + 1)) T3SUP_DEV_UI_FIXTURE_PORT=$((base + 10))

compose() {
  docker compose --project-name "$project" --file "$repo/docker/dev/compose.yaml" "$@"
}
tools() {
  compose run --rm tools "$@"
}
running() {
  [ -n "$(compose ps --status running --quiet env 2>/dev/null)" ]
}
# the container-side commands of the running environment (scripts/dev-environment.ts)
in_environment() {
  compose exec env node --import tsx scripts/dev-environment.ts "$@"
}
prepare='node --import tsx scripts/dev-environment.ts prepare'
flag=''
[ "$name" = default ] || flag=" --env $name"

setup() {
  compose build
  tools sh -c "$install"
}

summary() {
  cat <<SUMMARY
environment $name (Compose project $project)
  T3          http://127.0.0.1:$T3SUP_DEV_T3_PORT   ./dev$flag pair opens it in this browser
  Supervisor  http://127.0.0.1:$T3SUP_DEV_UI_PORT   ./dev$flag sign-in prints a one-time token
  health      http://127.0.0.1:$T3SUP_DEV_HEALTH_PORT/health
SUMMARY
}

up() {
  setup
  tools pnpm build
  compose up --detach --wait --wait-timeout 900 env
  summary
}

# one step of an upgrade journey in its journey container, which shares its network namespace with the published image
in_journey() {
  docker exec -i "$journey" node --import tsx scripts/upgrade-journey.ts "$@"
}

# the published image and the journey container are removed, and the journey folder too unless --keep was given
upgrade_cleanup() {
  docker rm --force "$published" >/dev/null 2>&1 || true
  docker stop --time 60 "$journey" >/dev/null 2>&1 || true
  docker rm --force "$journey" >/dev/null 2>&1 || true
  if [ "$keep" = yes ]; then
    printf '%s\n' "kept the journey folder $folder in the cache volume" >&2
  else
    compose run --rm -T tools node --import tsx scripts/upgrade-journey.ts discard "$folder" >/dev/null 2>&1 || true
  fi
}

# A published upgrade journey (docs/local-stack.md, "Published upgrade journeys"). The creating Supervisor, the published release run
# from its official image by digest or this checkout for the baseline, runs in the network namespace of a journey container whose
# main process serves T3; then this checkout's candidate starts on the directory it left. Only this host part runs Docker: it hands
# what only it sees, the pulled image's description, the forged sign-in token on a pipe, the image's exit code and its log, to
# scripts/upgrade-journey.ts, which makes every judgement and reports the journey.
upgrade_journey() {
  keep=no
  for argument in "$@"; do [ "$argument" != --keep ] || keep=yes; done
  setup
  tools pnpm build
  plan=$(compose run --rm -T tools node --import tsx scripts/upgrade-journey.ts plan --cache-dir /cache/t3-runtime "$@")
  folder=''
  image=''
  while IFS= read -r line; do
    case $line in
      folder=*) folder=${line#folder=} ;;
      image=*) image=${line#image=} ;;
    esac
  done <<PLAN
$plan
PLAN
  case $folder in /cache/xdg/t3-supervisor/local-runs/t3-supervisor-local-upgrade-*) ;; *) die "the journey plan named no journey folder" ;; esac
  case $folder in *[!A-Za-z0-9/._-]*) die "the journey plan named an unexpected folder" ;; esac
  case $image in
    '') ;;
    ghcr.io/jfet97/t3-supervisor@sha256:*)
      case ${image#ghcr.io/jfet97/t3-supervisor@sha256:} in *[!0-9a-f]*) die "the journey plan named an unexpected image" ;; esac ;;
    *) die "the journey plan named an unexpected image" ;;
  esac
  journey="$project-${folder##*/}"
  published="$journey-published"
  trap upgrade_cleanup EXIT
  trap 'exit 130' INT TERM
  compose run --detach --name "$journey" tools node --import tsx scripts/upgrade-journey.ts serve "$folder" >/dev/null
  if in_journey setup "$folder" </dev/null; then
    if [ -z "$image" ]; then
      in_journey baseline "$folder" </dev/null || true
    # Docker verifies by its digest what it pulls and runs; the journey checks the platform, version, revision and source it carries
    elif { docker pull --quiet "$image" >/dev/null && docker image inspect "$image"; } | in_journey image "$folder" &&
      docker run --detach --name "$published" --network "container:$journey" --user "$DEV_UID:$DEV_GID" --init --read-only \
        --tmpfs /tmp:size=128m,mode=1777 --cap-drop ALL --security-opt no-new-privileges:true \
        --mount "type=volume,src=${project}_cache,dst=/cache" --env T3_URL=http://127.0.0.1:3773 \
        --env "T3_TOKEN_FILE=$folder/secrets/t3-read-token" --env "DATA_DIRECTORY=$folder/supervisor" \
        --env UI_HOST=127.0.0.1 --env UI_PORT=9008 --env HEALTH_HOST=127.0.0.1 --env HEALTH_PORT=9007 \
        --env "T3_MANAGED_SCRATCH_ROOT=$folder/t3/scratch" "$image" >/dev/null; then
      if in_journey await "$folder" </dev/null; then
        # the sign-in token passes from the published CLI to the journey on a pipe; this host never prints or stores it
        docker exec "$published" t3-supervisor auth forge --data-dir "$folder/supervisor" | in_journey drive "$folder" || true
      fi
      docker stop --time 60 "$published" >/dev/null 2>&1 || true
      docker inspect --format '{{.State.ExitCode}}' "$published" | in_journey record "$folder" creator-exit || true
      docker logs "$published" 2>&1 | in_journey record "$folder" creator-log || true
    fi
  fi
  status=0
  in_journey finish "$folder" </dev/null || status=$?
  exit "$status"
}

# removes this environment's data volume after checking that Compose created it for this project
remove_data() {
  volume="${project}_data"
  if docker volume inspect "$volume" >/dev/null 2>&1; then
    owner=$(docker volume inspect --format '{{index .Labels "com.docker.compose.project"}}/{{index .Labels "com.docker.compose.volume"}}' "$volume")
    [ "$owner" = "$project/data" ] || die "volume $volume does not belong to $project; nothing was removed"
    docker volume rm "$volume" >/dev/null
  fi
}

case $command in
  setup) setup ;;
  up) up ;;
  stop) compose stop ;;
  start) compose start env ;;
  down) compose down ;;
  restart) compose restart env ;;
  recreate) compose up --detach --wait --wait-timeout 900 --force-recreate env; summary ;;
  rebuild) compose build --pull --no-cache; up ;;
  status)
    compose ps --all
    tools sh -c 'printf "codex: "; codex login status 2>&1 || true; printf "claude: "; claude auth status --text 2>&1 || true'
    ;;
  logs) compose logs "$@" env ;;
  shell) compose run --rm tools bash ;;
  pnpm) tools pnpm "$@" ;;
  login)
    provider=${1:-}
    [ $# -gt 0 ] && shift
    case $provider in
      codex) tools sh -c "$install >/dev/null && $prepare && exec codex login --device-auth \"\$@\"" sh "$@" ;;
      claude) tools sh -c "$install >/dev/null && $prepare && exec claude auth login \"\$@\"" sh "$@" ;;
      *) die "usage: ./dev login codex|claude [ARGS]" ;;
    esac
    ;;
  pair) running || die "the environment is not running; start it with ./dev$flag up"; in_environment pair ;;
  sign-in)
    running || die "the environment is not running; start it with ./dev$flag up"
    compose exec env node --import tsx src/cli.ts auth forge --data-dir /data/supervisor
    ;;
  fixture) compose run --rm --service-ports tools pnpm dev:fixture --host 0.0.0.0 --port "$T3SUP_DEV_FIXTURE_PORT" "$@" ;;
  ui-fixture)
    compose run --rm --service-ports tools node --import tsx test/ui-fixture/run.ts --assets ui-dist --host 0.0.0.0 \
      --port "$T3SUP_DEV_UI_FIXTURE_PORT" "$@"
    ;;
  check) tools pnpm dev:stack --check --cache-dir /cache/t3-runtime "$@" ;;
  upgrade) upgrade_journey "$@" ;;
  trial)
    running || die "the environment is not running; start it with ./dev$flag up"
    compose exec env node --import tsx scripts/provider-trial.ts "$@"
    ;;
  soak)
    setup
    tools pnpm test:soak "$@"
    ;;
  e2e)
    setup
    compose build e2e
    compose run --rm e2e sh -c 'pnpm build && exec pnpm test:e2e "$@"' sh "$@"
    ;;
  reset)
    running || compose up --detach --wait --wait-timeout 900 env
    in_environment reset-projects
    compose down
    remove_data
    printf '%s\n' "Test data removed. Provider sign-ins, T3 settings and T3 provider connections stay; start again with ./dev$flag up."
    ;;
  reset-auth)
    running || compose up --detach --wait --wait-timeout 900 env
    complete=yes
    in_environment logout-providers || complete=no
    in_environment logout-clis || complete=no
    [ "$complete" = yes ] || die "provider sign-out is incomplete; see the messages above and Settings > Providers (./dev$flag pair)"
    printf '%s\n' "Provider sign-ins of this environment are removed; T3 chats, settings and all data stay."
    ;;
  *) usage >&2; exit 2 ;;
esac
